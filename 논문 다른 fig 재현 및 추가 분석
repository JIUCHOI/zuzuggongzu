    {
      "cell_type": "code",
      "source": [
        "from scipy.interpolate import PchipInterpolator\n",
        "\n",
        "def plot_error_profiles_smooth_curve(\n",
        "    df,\n",
        "    y_col=\"frequency_smooth\",\n",
        "    output_prefix=\"FigS2C_smooth_curve\",\n",
        "    title_suffix=\"smoothed curve\"\n",
        "):\n",
        "    samples = list(df[\"sample\"].unique())\n",
        "    error_types = [\"Substitution\", \"Deletion\", \"Insertion\"]\n",
        "\n",
        "    fig, axes = plt.subplots(\n",
        "        1,\n",
        "        len(samples),\n",
        "        figsize=(5 * len(samples), 3.5),\n",
        "        sharex=True,\n",
        "        sharey=False\n",
        "    )\n",
        "\n",
        "    if len(samples) == 1:\n",
        "        axes = [axes]\n",
        "\n",
        "    for ax, sample in zip(axes, samples):\n",
        "        sample_df = df[df[\"sample\"] == sample]\n",
        "\n",
        "        for error_type in error_types:\n",
        "            sub = sample_df[sample_df[\"error_type\"] == error_type].sort_values(\"bin\")\n",
        "\n",
        "            x = sub[\"bin\"].to_numpy()\n",
        "            y = sub[y_col].to_numpy()\n",
        "\n",
        "            x_dense = np.linspace(1, 20, 200)\n",
        "            y_dense = PchipInterpolator(x, y)(x_dense)\n",
        "\n",
        "            # frequency는 음수가 될 수 없으므로 방어적으로 처리\n",
        "            y_dense = np.clip(y_dense, 0, None)\n",
        "\n",
        "            ax.plot(\n",
        "                x_dense,\n",
        "                y_dense,\n",
        "                linewidth=2,\n",
        "                label=error_type\n",
        "            )\n",
        "\n",
        "        ax.set_title(f\"{sample} {title_suffix}\")\n",
        "        ax.set_xlabel(\"Position in tag, 20 bins from 5′ end\")\n",
        "        ax.set_ylabel(\"Frequency (%)\")\n",
        "        ax.set_xticks(range(1, 21, 2))\n",
        "        ax.grid(alpha=0.3)\n",
        "\n",
        "    axes[0].legend(frameon=False)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f\"{output_prefix}.png\", dpi=200)\n",
