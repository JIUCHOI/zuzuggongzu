      "source": [
        "Cell 7. Figure S2C-like plot 그리기"
      ],
      "metadata": {
        "id": "gJ9p6091_iu9"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def plot_error_profile(profile_df, output_prefix=\"FigS2C_like_error_profile\"):\n",
        "    samples = profile_df[\"sample\"].unique().tolist()\n",
        "    error_types = [\"Substitution\", \"Deletion\", \"Insertion\"]\n",
        "\n",
        "    fig, axes = plt.subplots(\n",
        "        1,\n",
        "        len(samples),\n",
        "        figsize=(5 * len(samples), 3.5),\n",
        "        sharex=True,\n",
        "        sharey=False\n",
        "    )\n",
        "\n",
        "    if len(samples) == 1:\n",
        "        axes = [axes]\n",
        "\n",
        "    for ax, sample in zip(axes, samples):\n",
        "        sample_df = profile_df[profile_df[\"sample\"] == sample]\n",
        "\n",
        "        for error_type in error_types:\n",
        "            sub = sample_df[sample_df[\"error_type\"] == error_type]\n",
        "\n",
        "            ax.plot(\n",
        "                sub[\"bin\"],\n",
        "                sub[\"frequency_percent\"],\n",
        "                marker=\"o\",\n",
        "                linewidth=1.5,\n",
        "                label=error_type\n",
        "            )\n",
        "\n",
        "        ax.set_title(sample)\n",
        "        ax.set_xlabel(\"Position in tag, 20 bins from 5′ end\")\n",
        "        ax.set_ylabel(\"Frequency (%)\")\n",
        "        ax.set_xticks(range(1, 21, 2))\n",
        "        ax.grid(alpha=0.3)\n",
        "\n",
        "    axes[0].legend(frameon=False)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f\"{output_prefix}.png\", dpi=200)\n",
        "    plt.savefig(f\"{output_prefix}.pdf\")\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "plot_error_profile(\n",
        "    profile_df,\n",
        "    output_prefix=\"FigS2C_like_error_profile_2percent\"\n",
        ")"
      ],
