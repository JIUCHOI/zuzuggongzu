    {
      "cell_type": "markdown",
      "source": [
        "Cell 3. CIGAR / MD tag parsing 함수 만들기"
      ],
      "metadata": {
        "id": "Z-jTMVJA-7wv"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import re\n",
        "import subprocess\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "CIGAR_RE = re.compile(r'(\\d+)([MIDNSHP=X])')\n",
        "MD_RE = re.compile(r'(\\d+|\\^[A-Za-z]+|[A-Za-z]+)')\n",
        "\n",
        "\n",
        "def get_optional_tag(fields, tag_name):\n",
        "    \"\"\"\n",
        "    SAM optional field에서 특정 tag 값을 가져옴.\n",
        "    예:\n",
        "    MD:Z:39G1 -> get_optional_tag(fields, \"MD\") == \"39G1\"\n",
        "    NM:i:2    -> get_optional_tag(fields, \"NM\") == \"2\"\n",
        "    \"\"\"\n",
        "    prefix = tag_name + \":\"\n",
        "    for f in fields[11:]:\n",
        "        if f.startswith(prefix):\n",
        "            return f.split(\":\", 2)[2]\n",
        "    return None\n",
        "\n",
        "\n",
        "def read_bin(qpos, read_len, n_bins=20):\n",
        "    \"\"\"\n",
        "    read 내 0-based query position을 20개 bin 중 하나로 변환.\n",
        "    qpos = read에서 error가 발생한 위치\n",
        "    read_len = read 길이\n",
        "    \"\"\"\n",
        "    if read_len <= 0:\n",
        "        return None\n",
        "\n",
        "    qpos = max(0, min(qpos, read_len - 1))\n",
        "    b = int(qpos * n_bins / read_len)\n",
        "\n",
        "    return min(b, n_bins - 1)\n",
        "\n",
        "\n",
        "def cigar_match_segments(cigar):\n",
        "    \"\"\"\n",
        "    CIGAR를 보고 reference offset과 query position의 대응 segment를 만듦.\n",
        "\n",
        "    return:\n",
        "    [(ref_start, ref_end, query_start), ...]\n",
        "\n",
        "    ref_start <= ref_offset < ref_end 인 경우,\n",
        "    query_pos = query_start + (ref_offset - ref_start)\n",
        "    \"\"\"\n",
        "    ref_pos = 0\n",
        "    query_pos = 0\n",
        "    segments = []\n",
        "\n",
        "    for length, op in CIGAR_RE.findall(cigar):\n",
        "        length = int(length)\n",
        "\n",
        "        if op in [\"M\", \"=\", \"X\"]:\n",
        "            segments.append((ref_pos, ref_pos + length, query_pos))\n",
        "            ref_pos += length\n",
        "            query_pos += length\n",
        "\n",
        "        elif op == \"I\":\n",
        "            query_pos += length\n",
        "\n",
        "        elif op in [\"D\", \"N\"]:\n",
        "            ref_pos += length\n",
        "\n",
        "        elif op == \"S\":\n",
        "            query_pos += length\n",
        "\n",
        "        elif op in [\"H\", \"P\"]:\n",
        "            pass\n",
        "\n",
        "    return segments\n",
        "\n",
        "\n",
        "def ref_offset_to_query_pos(ref_offset, segments):\n",
        "    \"\"\"\n",
        "    MD tag에서 얻은 reference offset을 read query position으로 변환.\n",
        "    \"\"\"\n",
        "    for ref_start, ref_end, query_start in segments:\n",
        "        if ref_start <= ref_offset < ref_end:\n",
        "            return query_start + (ref_offset - ref_start)\n",
        "    return None\n",
        "\n",
        "\n",
        "def substitution_bins_from_md(md, cigar, read_len, n_bins=20):\n",
        "    \"\"\"\n",
        "    MD tag를 이용해서 substitution 위치를 찾고 bin으로 변환.\n",
        "    \"\"\"\n",
        "    segments = cigar_match_segments(cigar)\n",
        "\n",
        "    ref_offset = 0\n",
        "    bins = []\n",
        "\n",
        "    for token in MD_RE.findall(md):\n",
        "        if token.isdigit():\n",
        "            ref_offset += int(token)\n",
        "\n",
        "        elif token.startswith(\"^\"):\n",
        "            # deletion은 MD에도 나오지만, deletion 위치는 CIGAR에서 따로 계산할 것\n",
        "            ref_offset += len(token) - 1\n",
        "\n",
        "        else:\n",
        "            # token이 \"A\", \"G\", \"TC\"처럼 mismatch base들일 수 있음\n",
        "            for _base in token:\n",
        "                qpos = ref_offset_to_query_pos(ref_offset, segments)\n",
        "                if qpos is not None:\n",
        "                    b = read_bin(qpos, read_len, n_bins=n_bins)\n",
        "                    if b is not None:\n",
        "                        bins.append(b)\n",
        "                ref_offset += 1\n",
        "\n",
        "    return bins\n",
        "\n",
        "\n",
        "def indel_bins_from_cigar(cigar, read_len, n_bins=20):\n",
        "    \"\"\"\n",
        "    CIGAR에서 insertion / deletion 위치를 추출.\n",
        "    deletion은 read base가 없기 때문에 현재 query_pos 위치에 배정.\n",
        "    insertion은 삽입된 query base 위치에 배정.\n",
        "    \"\"\"\n",
        "    query_pos = 0\n",
        "\n",
        "    insertion_bins = []\n",
        "    deletion_bins = []\n",
        "\n",
        "    for length, op in CIGAR_RE.findall(cigar):\n",
        "        length = int(length)\n",
        "\n",
        "        if op in [\"M\", \"=\", \"X\"]:\n",
        "            query_pos += length\n",
        "\n",
        "        elif op == \"I\":\n",
        "            for k in range(length):\n",
        "                b = read_bin(query_pos + k, read_len, n_bins=n_bins)\n",
        "                if b is not None:\n",
        "                    insertion_bins.append(b)\n",
        "            query_pos += length\n",
        "\n",
        "        elif op == \"D\":\n",
        "            # 예: 10M1D9M이면 deletion은 11번째 bin 근처에 들어감\n",
        "            b = read_bin(query_pos, read_len, n_bins=n_bins)\n",
        "            if b is not None:\n",
        "                deletion_bins.extend([b] * length)\n",
        "\n",
        "        elif op == \"N\":\n",
        "            # spliced alignment는 보통 미리 제거할 예정\n",
        "            pass\n",
        "\n",
        "        elif op == \"S\":\n",
        "            query_pos += length\n",
        "\n",
        "        elif op in [\"H\", \"P\"]:\n",
        "            pass\n",
        "\n",
        "    return insertion_bins, deletion_bins"
      ],
      "metadata": {
        "id": "1xJzPjTF-x-L"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Cell 4. BAM 하나를 읽어서 error profile 계산하는 함수"
      ],
      "metadata": {
        "id": "bknWkv_a_DGC"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def summarize_error_profile(\n",
        "    bam_path,\n",
        "    sample_name,\n",
        "    n_bins=20,\n",
        "    subsample=\"42.02\",\n",
        "    skip_spliced=True,\n",
        "    max_reads=None\n",
        "):\n",
        "    \"\"\"\n",
        "    BAM 파일에서 substitution/deletion/insertion 위치를 20 bin profile로 요약.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    bam_path : str\n",
        "        BAM 파일 경로\n",
        "    sample_name : str\n",
        "        결과에 표시할 sample 이름\n",
        "    n_bins : int\n",
        "        read를 몇 개 bin으로 나눌지. Figure S2C는 20 bins.\n",
        "    subsample : str or None\n",
        "        samtools random subsampling 옵션.\n",
        "        \"42.02\" = seed 42, 약 2% subsampling.\n",
        "        전체 데이터는 None.\n",
        "    skip_spliced : bool\n",
        "        CIGAR에 N이 있는 read 제거 여부.\n",
        "    max_reads : int or None\n",
        "        디버깅용 최대 read 수 제한.\n",
        "    \"\"\"\n",
        "\n",
        "    # row 0 = substitution, row 1 = deletion, row 2 = insertion\n",
        "    error_counts = np.zeros((3, n_bins), dtype=np.int64)\n",
        "\n",
        "    total_reads = 0\n",
        "    error_reads = 0\n",
        "    skipped_no_md = 0\n",
        "    skipped_spliced = 0\n",
        "\n",
        "    cmd = [\"samtools\", \"view\", \"-F\", \"20\"]\n",
        "\n",
        "    if subsample is not None:\n",
        "        cmd += [\"-s\", subsample]\n",
        "\n",
        "    cmd += [bam_path]\n",
        "\n",
        "    print(\"Running:\", \" \".join(cmd))\n",
        "\n",
        "    proc = subprocess.Popen(\n",
        "        cmd,\n",
        "        stdout=subprocess.PIPE,\n",
        "        stderr=subprocess.PIPE,\n",
        "        text=True\n",
        "    )\n",
        "\n",
        "    try:\n",
        "        for line in proc.stdout:\n",
        "            if max_reads is not None and total_reads >= max_reads:\n",
        "                break\n",
        "\n",
        "            fields = line.rstrip(\"\\n\").split(\"\\t\")\n",
        "\n",
        "            if len(fields) < 11:\n",
        "                continue\n",
        "\n",
        "            cigar = fields[5]\n",
        "            seq = fields[9]\n",
        "\n",
        "            if cigar == \"*\" or seq == \"*\":\n",
        "                continue\n",
        "\n",
        "            if skip_spliced and \"N\" in cigar:\n",
        "                skipped_spliced += 1\n",
        "                continue\n",
        "\n",
        "            read_len = len(seq)\n",
        "            total_reads += 1\n",
        "\n",
        "            nm = get_optional_tag(fields, \"NM\")\n",
        "\n",
        "            # NM tag가 없으면 일단 skip\n",
        "            if nm is None:\n",
        "                continue\n",
        "\n",
        "            # NM:i:0이면 error 없음. denominator에는 들어가지만 parsing은 skip.\n",
        "            try:\n",
        "                nm_int = int(nm)\n",
        "            except ValueError:\n",
        "                nm_int = 0\n",
        "\n",
        "            if nm_int == 0:\n",
        "                continue\n",
        "\n",
        "            md = get_optional_tag(fields, \"MD\")\n",
        "            if md is None:\n",
        "                skipped_no_md += 1\n",
        "                continue\n",
        "\n",
        "            error_reads += 1\n",
        "\n",
        "            # 1) substitution: MD tag\n",
        "            s_bins = substitution_bins_from_md(\n",
        "                md=md,\n",
        "                cigar=cigar,\n",
        "                read_len=read_len,\n",
        "                n_bins=n_bins\n",
        "            )\n",
        "\n",
        "            for b in s_bins:\n",
        "                error_counts[0, b] += 1\n",
        "\n",
        "            # 2) insertion/deletion: CIGAR\n",
        "            i_bins, d_bins = indel_bins_from_cigar(\n",
        "                cigar=cigar,\n",
        "                read_len=read_len,\n",
        "                n_bins=n_bins\n",
        "            )\n",
        "\n",
        "            for b in d_bins:\n",
        "                error_counts[1, b] += 1\n",
        "\n",
        "            for b in i_bins:\n",
        "                error_counts[2, b] += 1\n",
        "\n",
        "    finally:\n",
        "        if proc.poll() is None:\n",
        "            proc.terminate()\n",
        "\n",
        "    print(f\"\\n[{sample_name}]\")\n",
        "    print(f\"Total reads used       : {total_reads:,}\")\n",
        "    print(f\"Reads with NM > 0      : {error_reads:,}\")\n",
        "    print(f\"Skipped spliced reads  : {skipped_spliced:,}\")\n",
        "    print(f\"Skipped no MD tag      : {skipped_no_md:,}\")\n",
        "\n",
        "    result = {\n",
        "        \"sample\": sample_name,\n",
        "        \"bam\": bam_path,\n",
        "        \"total_reads\": total_reads,\n",
        "        \"error_reads\": error_reads,\n",
        "        \"error_counts\": error_counts,\n",
        "        \"n_bins\": n_bins,\n",
        "        \"subsample\": subsample,\n",
        "    }\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "def result_to_dataframe(result):\n",
        "    error_type_names = [\"Substitution\", \"Deletion\", \"Insertion\"]\n",
        "\n",
        "    records = []\n",
        "\n",
        "    for error_idx, error_type in enumerate(error_type_names):\n",
        "        for bin_idx in range(result[\"n_bins\"]):\n",
        "            count = result[\"error_counts\"][error_idx, bin_idx]\n",
        "            total_reads = result[\"total_reads\"]\n",
        "\n",
        "            frequency_percent = 100 * count / total_reads if total_reads > 0 else 0\n",
        "\n",
        "            records.append({\n",
        "                \"sample\": result[\"sample\"],\n",
        "                \"bin\": bin_idx + 1,\n",
